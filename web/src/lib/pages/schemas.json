    "name": "projectsStats",
    "type": "array",
    "label": "Stats Strip",
    "defaultValue": [
     {
      "value": 10,
      "suffix": "+",
      "label": "Years Experience"
     },
     {
      "value": 30,
      "suffix": "+",
      "label": "Projects Completed"
     },
     {
      "value": 50,
      "suffix": "+",
      "label": "Happy Clients"
     },
     {
      "text": "Kigali",
      "label": "Rwanda"
     }
