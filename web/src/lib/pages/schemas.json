      "required": true
     },
     {
      "name": "description",
      "type": "textarea",
      "required": true
     }
    ]
   },
   {
    "name": "partnersSection",
    "type": "group",
    "label": "Partners Section Copy",
    "fields": [
     {
      "name": "eyebrow",
      "type": "text",
      "required": true
     },
     {
      "name": "heading",
      "type": "text",
      "required": true
     },
     {
      "name": "description",
      "type": "textarea",
      "required": true
     }
    ]
   },
   {
    "name": "whyChooseUs",
    "type": "group",
    "label": "Why Choose Us Section",
    "fields": [
     {
      "name": "eyebrow",
      "type": "text",
      "required": true
     },
     {
      "name": "headingStart",
      "type": "text",
      "required": true,
      "description": "e.g. \"Built on\" (non-highlighted part)"
     },
     {
      "name": "headingHighlight",
      "type": "text",
      "required": true,
      "description": "e.g. \"Trust\" (shown in gold)"
     },
     {
      "name": "headingEnd",
      "type": "text",
      "required": true,
      "description": "e.g. \"Delivered with Precision\""
     },
     {
      "name": "subtext",
      "type": "textarea",
      "required": true
     },
     {
      "name": "reasons",
      "type": "array",
      "maxRows": 8,
      "minRows": 1,
      "fields": [
       {
        "name": "title",
        "type": "text",
        "required": true
       },
       {
        "name": "description",
        "type": "textarea",
        "required": true
       }
      ]
     },
     {
      "name": "backgroundImage",
      "type": "upload",
      "required": true,
      "relationTo": "media",
      "description": "Parallax background behind the section."
     },
     {
      "name": "media",
      "type": "group",
      "label": "Right Column Media",
      "fields": [
       {
        "name": "type",
        "type": "select",
        "required": true,
        "options": [
         "image",
         "video"
        ],
        "defaultValue": "image"
       },
       {
        "name": "image",
        "type": "upload",
        "relationTo": "media"
       },
       {
        "name": "video",
        "type": "upload",
        "relationTo": "media"
       },
       {
        "name": "alt",
        "type": "text"
       }
      ]
     },
     {
      "name": "ctaLabel",
      "type": "text",
      "required": true
     },
     {
      "name": "ctaLink",
      "type": "text",
      "required": true,
      "description": "Internal path, e.g. /about"
     }
    ]
   },
   {
    "name": "partnersTeaser",
    "type": "group",
    "label": "Partners Strip",
    "description": "Heading above the partner logos on the home page. Logos are managed in the Partners collection; the strip is hidden when there are none.",
    "fields": [
     {
      "name": "eyebrow",
      "type": "text",
      "defaultValue": "Trusted By"
     },
     {
      "name": "heading",
      "type": "text",
      "defaultValue": "Our Partners"
     }
    ]
   },
   {
    "name": "cta",
    "type": "group",
    "label": "Closing CTA",
    "fields": [
     {
      "name": "eyebrow",
      "type": "text",
      "required": true
     },
     {
      "name": "headingStart",
      "type": "text",
      "required": true
     },
     {
      "name": "headingHighlight",
      "type": "text",
      "required": true
     },
     {
      "name": "headingEnd",
      "type": "text",
      "required": true
     },
     {
      "name": "subline",
      "type": "textarea",
      "required": true
     },
     {
      "name": "primaryBtnLabel",
      "type": "text",
      "required": true
     },
     {
      "name": "primaryBtnLink",
      "type": "text",
      "required": true
     },
     {
      "name": "secondaryBtnLabel",
      "type": "text",
      "required": true
     },
     {
      "name": "secondaryBtnLink",
      "type": "text",
      "required": true
     }
    ]
   }
  ]
 },
