[
 {
  "slug": "home-page",
  "label": "home-page",
  "description": "All homepage-specific content: Hero slides, Stats, and the copy for the Services/Projects/Testimonials teasers and closing CTA. The actual Services/Projects/Testimonials items themselves live in their own collections, not here.",
  "fields": [
   {
    "name": "hero",
    "type": "group",
    "fields": [
     {
      "name": "eyebrow",
      "type": "text",
      "required": true
     },
     {
      "name": "slides",
      "type": "array",
      "minRows": 1,
      "description": "Background rotation. Each slide is either a video or an image — pick the type, then fill in the matching field below it.",
      "fields": [
       {
        "name": "type",
        "type": "select",
        "required": true,
        "options": [
         "image",
         "video"
        ],
        "defaultValue": "image"
       },
       {
        "name": "image",
        "type": "upload",
        "relationTo": "media"
       },
       {
        "name": "video",
        "type": "upload",
        "relationTo": "media",
        "description": "Requires video mimeTypes to be allowed on the Media collection — see note below."
       },
       {
        "name": "poster",
        "type": "upload",
        "relationTo": "media",
        "description": "Shown before the video loads/plays."
       },
       {
        "name": "headline",
        "type": "text",
        "required": true
       },
       {
        "name": "subline",
        "type": "textarea",
        "required": true
       },
       {
        "name": "duration",
        "type": "number",
        "defaultValue": 7000,
        "description": "Milliseconds shown before auto-advancing (image slides only — video slides advance when the video ends)."
       }
      ]
     },
     {
      "name": "foreground",
      "type": "group",
      "label": "Foreground Worker Image",
      "fields": [
       {
        "name": "image",
        "type": "upload",
        "required": true,
        "relationTo": "media"
       },
       {
        "name": "alt",
        "type": "text",
        "required": true
       }
      ]
     },
     {
      "name": "primaryBtnLabel",
      "type": "text",
      "required": true
     },
     {
      "name": "primaryBtnLink",
      "type": "text",
      "required": true
     },
     {
      "name": "secondaryBtnLabel",
      "type": "text",
      "required": true
     },
     {
      "name": "secondaryBtnLink",
      "type": "text",
      "required": true
     }
    ]
   },
   {
    "name": "stats",
    "type": "group",
    "fields": [
     {
      "name": "eyebrow",
      "type": "text",
      "required": true
     },
     {
      "name": "heading",
      "type": "text",
      "required": true
     },
     {
      "name": "supportingText",
      "type": "textarea",
      "required": true
     },
     {
      "name": "items",
      "type": "array",
      "maxRows": 4,
      "minRows": 1,
      "fields": [
       {
        "name": "iconKey",
        "type": "select",
        "required": true,
        "options": [
         {
          "label": "Years (Clock)",
          "value": "years"
         },
         {
          "label": "Projects (Building2)",
          "value": "projects"
         },
         {
          "label": "Clients (Users)",
          "value": "clients"
         },
         {
          "label": "Location (MapPin)",
          "value": "location"
         }
        ]
       },
       {
        "name": "value",
        "type": "number",
        "description": "Leave blank for a non-numeric stat (e.g. a location name) and use Text below instead."
       },
       {
        "name": "text",
        "type": "text",
        "description": "Only used when Value is left blank, e.g. \"Kigali\"."
       },
       {
        "name": "suffix",
        "type": "text",
        "description": "e.g. \"+\""
       },
       {
        "name": "label",
        "type": "text",
        "required": true
       },
       {
        "name": "description",
        "type": "textarea",
        "required": true
       }
      ]
     }
    ]
   },
   {
    "name": "servicesTeaser",
    "type": "group",
    "label": "Services Teaser Copy",
    "fields": [
     {
      "name": "eyebrow",
      "type": "text",
      "required": true
     },
     {
      "name": "heading",
      "type": "text",
      "required": true
     },
     {
      "name": "viewAllLabel",
      "type": "text",
      "required": true
     },
     {
      "name": "viewAllLink",
      "type": "text",
      "required": true
     }
    ]
   },
   {
