 {
  "slug": "projects-page",
  "label": "projects-page",
  "description": "Page-level content for the Projects page: hero copy, empty-state message, detail-page section labels, and the closing CTA.",
  "fields": [
   {
    "name": "projectsHero",
    "type": "group",
    "label": "Hero",
