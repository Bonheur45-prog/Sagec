// SAGEC Ltd — database schema (PostgreSQL)
//
// Conventions (same as the BrightLink and Oak Elite Home CMSs, minus languages)
// - SAGEC is English only: text lives directly on each row, there are no *Translation tables.
// - Page layouts are stored as JSON (an ordered list of section blocks) so reordering,
//   draft/publish and version history stay simple. Block shapes are validated in code. (Phase 4)
// - Nothing the editor may want to change (phone, address, analytics ID...) is hardcoded: it lives
//   in SiteSettings. (Phase 2)
//
// Built in phases: each phase adds its tables with its own migration (npm run db:migrate).
// Phase 1: users, sessions, media library, activity log.
// Phase 2: site settings, header/footer (draft → publish), version history.
// Phase 3a: services, projects (+ gallery), testimonials, partners, job openings, redirects.
// PR 6: blog (categories, authors, posts, comments), contact messages, newsletter subscribers.

generator client {
  provider        = "prisma-client-js"
  // Rust-free client: queries are compiled in JavaScript and sent through the pg driver (src/lib/db.ts).
  // No native query-engine process: less memory on the VPS, and nothing extra to download at install.
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum MediaKind {
  IMAGE
  VIDEO
}

/// Draft = hidden from the website. For job openings: Published = open, Draft = closed.
enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum ProjectState {
  COMPLETED
  IN_PROGRESS
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

// ───────────────────────── Users ─────────────────────────

/// One role: every user can manage everything. Safety net = soft delete + version history + audit log.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  sessions Session[]
  uploads  MediaAsset[]
  audit    AuditLog[]
}

/// A logged-in browser. Only the SHA-256 hash of the cookie token is stored.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Site settings ─────────────────────────

/// One row (id 1). Saved immediately (no draft): a phone number must never wait for a publish.
model SiteSettings {
  id                     Int      @id @default(1)
  companyName            String
  legalName              String
  tagline                String   @default("")
  footerDescription      String   @default("") // empty = the tagline
  phone                  String   @default("")
  secondaryPhone         String   @default("")
  publicEmail            String   @default("")
  notificationEmail      String   @default("") // where new contact messages are emailed (Phase 3)
  whatsappNumber         String   @default("") // digits only, with country code, e.g. 250788470243
  whatsappLabel          String   @default("")
  responseNote           String   @default("") // short line under the contact details
  addressStreet          String   @default("")
  addressCity            String   @default("")
  addressCountry         String   @default("")
  addressCountryCode     String   @default("")
  /// Rows like [{ "day": "Monday – Friday", "hours": "8:00 AM – 5:00 PM" }]
  businessHours          Json     @default("[]")
  /// [{ "platform": "linkedin", "url": "https://…" }]
  socials                Json     @default("[]")
  logoMediaId            String?
  logoLightMediaId       String? // logo for dark backgrounds (footer, over hero photos)
  defaultOgMediaId       String? // social-share image used when a page has none
  seoTitle               String   @default("") // default <title> when a page has none
  seoDescription         String   @default("")
  titleTemplate          String   @default("%s | SAGEC Ltd")
  googleSiteVerification String   @default("")
  /// Google Analytics 4 measurement ID (G-…). Empty = no analytics. Never loaded on /admin.
  googleAnalyticsId      String   @default("")
  headingFont            String   @default("plus-jakarta-sans")
  bodyFont               String   @default("inter")
  smoothScroll           Boolean  @default(true)
  parallax               Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

// ───────────────────────── Draft / publish ─────────────────────────

/// Site-wide pieces edited as a draft and published: "header", "footer".
model GlobalSection {
  id          String    @id @default(cuid())
  key         String    @unique
  draft       Json      @default("{}")
  published   Json?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Snapshot taken on every publish so an earlier version can be restored (30 kept per document).
model ContentVersion {
  id          String   @id @default(cuid())
  entityType  String // "global" (Phase 4 adds "page", Phase 5 "post")
  entityKey   String
  snapshot    Json
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityKey, createdAt])
}

// ───────────────────────── Media (Cloudflare R2) ─────────────────────────

/// A file stored in Cloudflare R2. Photos are stored as WebP in several widths (`variants`) so the
/// browser downloads a size that fits its screen; width/height and a blur placeholder are captured at
/// upload so layouts never jump.
model MediaAsset {
  id           String    @id @default(cuid())
  kind         MediaKind
  objectKey    String    @unique // the largest stored version
  mimeType     String
  sizeBytes    Int
  width        Int
  height       Int
  /// Smaller copies of a photo: [{ "w": 480, "key": "uploads/2026/11/abc-480.webp", "h": 270 }]
  variants     Json      @default("[]")
  durationSec  Int? // videos only
  blurDataUrl  String?   @db.Text
  posterKey    String? // video poster image key
  /// What the picture shows, for screen readers and Google.
  alt          String    @default("")
  uploadedById String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime? // soft delete: the files are only purged from R2 when removed from the trash

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  serviceCovers      Service[]     @relation("ServiceCover")
  serviceDetails     Service[]     @relation("ServiceDetail")
  projectCovers      Project[]     @relation("ProjectCover")
  projectFeatures    Project[]     @relation("ProjectFeatured")
  projectGallery     ProjectMedia[]
  testimonialAvatars Testimonial[] @relation("TestimonialAvatar")
  partnerLogos       Partner[]     @relation("PartnerLogo")
  postCovers         Post[]        @relation("PostCover")
  authorAvatars      BlogAuthor[]  @relation("AuthorAvatar")

  @@index([createdAt])
  @@index([deletedAt])
}

// ───────────────────────── Content collections ─────────────────────────
// Every collection: status (draft/published), sortOrder (lower first) and deletedAt (trash).

model Service {
  id               String        @id @default(cuid())
  slug             String        @unique
  status           PublishStatus @default(DRAFT)
  title            String
  shortDescription String        @default("") // cards and the services list
  /// Key of the icon shown on cards: architecture, structure, mep, management, construction, interior
  icon             String        @default("")
  /// What SAGEC delivers for this service, one item per entry: ["Concept design", ...]
  deliverables     Json          @default("[]")
  coverMediaId     String? // card photo
  detailMediaId    String? // large photo on the service's own page (empty = the card photo)
  showOnHome       Boolean       @default(true)
  sortOrder        Int           @default(0)
  metaTitle        String        @default("")
  metaDescription  String        @default("")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  coverMedia  MediaAsset?      @relation("ServiceCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  detailMedia MediaAsset?      @relation("ServiceDetail", fields: [detailMediaId], references: [id], onDelete: SetNull)
  projects    ProjectService[]

  @@index([status, deletedAt, sortOrder])
}

model Project {
  id               String        @id @default(cuid())
  slug             String        @unique
  status           PublishStatus @default(DRAFT)
  title            String
  /// One of PROJECT_CATEGORIES (src/lib/cms/collections-validation.ts), e.g. "Commercial"
  category         String        @default("")
  state            ProjectState  @default(COMPLETED)
  progress         Int           @default(100) // 0–100; 100 for completed projects
  year             String        @default("") // "2024", or "2023–2025"
  location         String        @default("")
  client           String        @default("")
  area             String        @default("") // e.g. "12,000 m²"
  shortDescription String        @default("") // cards
  /// The project page text, one paragraph per entry
  paragraphs       Json          @default("[]")
  /// Key facts shown as a list, one per entry
  highlights       Json          @default("[]")
  /// The one project shown big at the top of the Projects page (only one at a time)
  featured         Boolean       @default(false)
  showOnHome       Boolean       @default(true)
  sortOrder        Int           @default(0)
  coverMediaId     String? // card photo
  featuredMediaId  String? // wide photo for the project page hero (empty = the cover)
  metaTitle        String        @default("")
  metaDescription  String        @default("")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  coverMedia    MediaAsset?      @relation("ProjectCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  featuredMedia MediaAsset?      @relation("ProjectFeatured", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  gallery       ProjectMedia[]
  services      ProjectService[]

  @@index([status, deletedAt, sortOrder])
}

/// Ordered gallery of a project.
model ProjectMedia {
  projectId String
  mediaId   String
  position  Int

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id])

  @@id([projectId, mediaId])
  @@index([mediaId])
}

/// Which services a project used (a project can use several).
model ProjectService {
  projectId String
  serviceId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
  @@index([serviceId])
}

model Testimonial {
  id             String        @id @default(cuid())
  name           String
  role           String        @default("") // e.g. "CEO, Kigali Commercial Ventures"
  quote          String        @default("")
  avatarMediaId  String? // empty = initials
  status         PublishStatus @default(DRAFT)
  showOnHome     Boolean       @default(true)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?

  avatarMedia MediaAsset? @relation("TestimonialAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
}

/// Partner and client logos (the strip on the home page).
model Partner {
  id          String        @id @default(cuid())
  name        String
  website     String        @default("")
  logoMediaId String?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  logoMedia MediaAsset? @relation("PartnerLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
}

/// Careers page. Published = open (on the website), Draft = closed (hidden, kept to reopen later).
model Job {
  id           String        @id @default(cuid())
  title        String
  department   String        @default("") // one of JOB_DEPARTMENTS
  type         String        @default("Full-time") // one of JOB_TYPES
  location     String        @default("Kigali, Rwanda")
  description  String        @default("")
  /// One requirement per entry
  requirements Json          @default("[]")
  applyEmail   String        @default("") // empty = Careers default, then the public email
  applyLink    String        @default("")
  status       PublishStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
}

// ───────────────────────── Blog ─────────────────────────

model BlogCategory {
  id              String @id @default(cuid())
  slug            String @unique
  name            String
  description     String @default("")
  metaTitle       String @default("")
  metaDescription String @default("")
  sortOrder       Int    @default(0)

  posts Post[]
}

/// Who wrote an article (shown with the article). Not a CMS login.
model BlogAuthor {
  id            String  @id @default(cuid())
  name          String
  role          String  @default("")
  bio           String  @default("")
  avatarMediaId String?
  /// [{ "platform": "linkedin", "url": "https://…" }]
  socials       Json    @default("[]")
  sortOrder     Int     @default(0)

  avatarMedia MediaAsset? @relation("AuthorAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  posts       Post[]
}

model Post {
  id              String        @id @default(cuid())
  slug            String        @unique
  status          PublishStatus @default(DRAFT)
  title           String
  excerpt         String        @default("")
  /// The editor's document (Tiptap JSON). Only the admin ever reads this.
  doc             Json          @default("{}")
  /// Clean HTML rendered from `doc` when the post is saved, so visitors never download the editor.
  html            String        @default("") @db.Text
  /// [{ "id": "why-it-matters", "text": "Why it matters", "level": 2 }]
  toc             Json          @default("[]")
  /// Font keys the article uses (src/lib/fonts.ts): only these are downloaded on the post's page.
  fonts           String[]      @default([])
  categoryId      String
  authorId        String? // empty = "SAGEC Team"
  coverMediaId    String?
  tags            String[]      @default([])
  featured        Boolean       @default(false)
  readingMinutes  Int           @default(1)
  focusKeyword    String        @default("")
  metaTitle       String        @default("")
  metaDescription String        @default("")
  ogMediaId       String?
  canonicalUrl    String        @default("")
  noIndex         Boolean       @default(false)
  /// Set when first published. A date in the future means "scheduled": hidden until then.
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  category   BlogCategory  @relation(fields: [categoryId], references: [id])
  author     BlogAuthor?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  coverMedia MediaAsset?   @relation("PostCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  comments   BlogComment[]

  @@index([status, publishedAt])
}

/// Visitors' comments. Hidden until approved in CMS → Comments.
model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  name      String
  email     String // never shown on the website
  website   String   @default("")
  text      String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, approved])
  @@index([approved, createdAt])
}

// ───────────────────────── Messages and subscribers ─────────────────────────

/// A message from the contact form. Saved first, then emailed to the team.
model Lead {
  id           String     @id @default(cuid())
  status       LeadStatus @default(NEW)
  name         String
  email        String
  phone        String     @default("")
  /// "personal" or "company" (the contact form's choice)
  category     String     @default("personal")
  organisation String     @default("")
  subject      String     @default("")
  message      String     @default("") @db.Text
  source       String     @default("") // which form or page it came from
  userAgent    String?
  notifiedAt   DateTime? // set when the notification email was sent
  notifyError  String? // set when sending failed, so nothing is silently lost
  createdAt    DateTime   @default(now())

  @@index([status, createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Old address → new address. Created when a service or project address (slug) is renamed,
/// so links already shared keep working.
model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique // "/projects/old-slug"
  toPath    String
  permanent Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ───────────────────────── Activity log ─────────────────────────

/// Who changed what, shown in CMS → Activity.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // "media.upload", "user.create", ...
  entityType String
  entityId   String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
