{
  "name": "sagec-website",
  "version": "0.1.0",
  "private": true,
  "description": "SAGEC Ltd — website and custom CMS (Next.js + Prisma + PostgreSQL + Cloudflare R2)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "user:create": "tsx scripts/create-user.ts",
    "import:payload": "tsx --conditions=react-server scripts/import-payload.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.106.1",
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-highlight": "^3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-table": "^3.32.3",
    "@tiptap/extension-text-align": "^3.32.3",
    "@tiptap/extension-text-style": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@types/pg": "^8.23.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.400.0",
    "next": "^15.5.28",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.4.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
