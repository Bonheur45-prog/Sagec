# Copy to .env and fill in. Never commit .env.

# PostgreSQL. This value matches docker-compose.yml for local development.
DATABASE_URL="postgresql://sagec:sagec@localhost:5434/sagec?schema=public"

# Public site address, used for the sitemap, share links and canonical addresses (no trailing slash).
SITE_URL="http://localhost:3000"

# ── Cloudflare R2: where photos and videos uploaded in the CMS are stored ──
# Optional, only for testing against another S3-compatible server instead of real R2:
# R2_ENDPOINT="http://localhost:9000"
# Cloudflare dashboard → R2 → your bucket. The CORS rule videos need is in web/docs/DEPLOY.md (Phase 7).
# TODO: fill in once the SAGEC bucket exists.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""        # R2 → Manage API tokens → create token with "Object Read & Write" on this bucket
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""               # e.g. sagec-media
R2_PUBLIC_HOSTNAME=""      # custom domain or r2.dev subdomain, without https://, e.g. media.sagecltd.com

# ── Email: every new contact message is emailed to the "Notification email" in Site settings ──
# Any SMTP server works. Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_USER = the Gmail address,
# SMTP_PASS = a 16-character App Password (Google Account → Security → 2-Step Verification → App passwords).
# Without these, messages are still saved in CMS → Messages, with a note saying they were not emailed.
# TODO: fill in before launch.
SMTP_HOST=""
SMTP_PORT="465"            # 465 (TLS) or 587 (STARTTLS)
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""              # e.g. "SAGEC website <sagecltd@gmail.com>" (Gmail: must be SMTP_USER)

# ── Spam protection for the public forms: Cloudflare Turnstile ──
# Cloudflare dashboard → Turnstile → Add widget (domains: sagecltd.com, localhost). Leave empty to skip in development.
# TODO: fill in before launch.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
