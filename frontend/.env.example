# Base URL of the Payload CMS (no trailing slash, no /api).
# Required for the site to load any content at all in production —
# without it, the app falls back to http://localhost:3000.
VITE_API_URL=https://your-cms-domain.com

# Your live frontend URL (no trailing slash). Used to build correct
# canonical/Open Graph URLs (see src/components/ui/Seo.jsx) and by
# `npm run generate:sitemap` to build sitemap.xml. Falls back to
# window.location.origin in the browser if unset, but is required
# for the sitemap generator to run at all.
VITE_SITE_URL=https://your-frontend-domain.com

# EmailJS credentials for the contact form (see sections/contact/ContactMain.jsx)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
