  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.js || echo 'Sitemap generation skipped (VITE_API_URL/VITE_SITE_URL not set yet, or CMS unreachable) — continuing build without it.'",
    "build": "vite build",
    "generate:sitemap": "node scripts/generate-sitemap.js",
